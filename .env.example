# =================================================================
# Nirikshan-AI Environment Configuration Template (Production Ready)
# =================================================================

# Server & Application Mode
NODE_ENV=production
PORT=5000

# Database Configuration
# Replace with production MongoDB URI (with authentication enabled for government deployment)
MONGODB_URI=mongodb://mongodb:27017/nirikshan

# Authentication & Security
# IMPORTANT: Generate a strong, 64-character random string for production deployment
JWT_SECRET=change_this_to_a_secure_64_char_random_secret_in_production
JWT_EXPIRES_IN=7d

# Microservices Inter-Service Communication
AI_SERVICE_URL=http://ai-service:8000

# Security: Allowed CORS Origins (comma-separated list of official domain names)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://nirikshan.mospi.gov.in

# Frontend Options (Vite environment variables)
VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCK_DATA=false
